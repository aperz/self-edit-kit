---
permalink: blog/index.html
layout: base.njk
title: Blog
---
{#-
  The blog list at /blog/. PROTECTED: only Aleksandra changes this file.
  Lists collections.wpisy (every post in content/blog/, newest first; see
  eleventy.config.js) with cover, Polish date and excerpt.
-#}
<main class="narrow blog">
  <h1>Blog</h1>
{%- for post in collections.wpisy %}
  <article class="post-card">
    <a href="{{ post.url }}"><img src="{{ post.data.cover | obraz }}" alt="{{ post.data.cover_alt }}" loading="lazy"></a>
    <div>
      <p class="post-date"><time datetime="{{ post.date | data_iso }}">{{ post.date | data_pl }}</time></p>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p>{{ post.data.excerpt }}</p>
    </div>
  </article>
{%- else %}
  <p>Wkrótce pierwsze wpisy.</p>
{%- endfor %}
</main>
